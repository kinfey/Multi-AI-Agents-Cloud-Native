# =============================================================================
# teamsbot_app — Microsoft Teams bot (MCP client) configuration
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# =============================================================================

# ---- Bot Framework credentials (from the Azure Bot registration) -----------
# MICROSOFT_APP_ID: the Entra app (client) ID of the Azure Bot registration.
#   Leave empty to run locally in the Bot Framework Emulator without auth.
MICROSOFT_APP_ID=
# MICROSOFT_APP_PASSWORD: the client secret for MICROSOFT_APP_ID (SECRET —
#   do not commit). Create with `az ad app credential reset --id <APP_ID>`.
MICROSOFT_APP_PASSWORD=
# MICROSOFT_APP_TYPE: bot identity model — SingleTenant | MultiTenant |
#   UserAssignedMSI (default: MultiTenant). New bots must use SingleTenant.
MICROSOFT_APP_TYPE=SingleTenant
# MICROSOFT_APP_TENANT_ID: Entra tenant (directory) ID. REQUIRED only when
#   MICROSOFT_APP_TYPE=SingleTenant; leave empty otherwise.
MICROSOFT_APP_TENANT_ID=

# PORT: TCP port the bot's /api/messages endpoint listens on (default: 3978).
PORT=3978

# ---- OpenClaw MCP service (acamcp_node) endpoint ---------------------------
# MCP_URL: the MCP streamable-HTTP endpoint the bot calls (…/mcp). This is the
#   public AKS ingress (self-signed TLS + optional HTTP Basic auth).
MCP_URL=https://<mcp-ingress-host>/mcp
# MCP_BASIC_AUTH_USER: HTTP Basic auth username for the MCP ingress.
MCP_BASIC_AUTH_USER=mcp
# MCP_BASIC_AUTH_PASSWORD: HTTP Basic auth password for the MCP ingress
#   (SECRET — do not commit). Matches acamcp_node's acamcp-basic-auth secret.
MCP_BASIC_AUTH_PASSWORD=
# MCP_TLS_INSECURE: set to `true` to skip TLS certificate verification when the
#   MCP host uses a self-signed / nip.io certificate (default: false).
MCP_TLS_INSECURE=true

# MCP_TOOL_TIMEOUT_MS: per-request client timeout for a single tool call, in ms
#   (default: 900000 = 15 min). It is RESET on every progress notification from
#   the server, so it rarely trips during a long generate_prototype run.
MCP_TOOL_TIMEOUT_MS=900000
# MCP_MAX_TOTAL_TIMEOUT_MS: absolute cap for the whole generate_prototype call,
#   in ms (default: 3600000 = 60 min). NOT reset by progress, so it must cover a
#   full run including test/deploy retry loops — too low causes
#   "Maximum total timeout exceeded".
MCP_MAX_TOTAL_TIMEOUT_MS=3600000

# ---- Local "open the result" actions (only when running the bot locally) ----
# AUTO_OPEN_LOCAL: when `true` AND the bot runs on your own machine, after a
#   workflow finishes the bot opens deployed_url in the default browser,
#   downloads download_url, extracts it into DOWNLOAD_DIR and opens it in
#   VS Code. Has NO effect on the ACA-hosted bot (the container cannot reach
#   your browser / editor) — keep it `false` in the cloud (default: false).
AUTO_OPEN_LOCAL=false
# DOWNLOAD_DIR: where to save + extract the downloaded source (default:
#   ~/Downloads). `~` expands to your home directory; a relative path like
#   ./Downloads resolves against the bot's working directory, NOT your home.
DOWNLOAD_DIR=~/Downloads
# EDITOR_PREFERENCE: which editor to open the extracted project with —
#   auto | insiders | code (default: auto).
EDITOR_PREFERENCE=auto
# OPENCLAW_GATEWAY_TOKEN: gateway bearer token required to download the artifact
#   ZIP (SECRET — do not commit, ~48 hex chars). Same value as
#   acasbxapp_node/.env OPENCLAW_GATEWAY_TOKEN. Only needed for AUTO_OPEN_LOCAL.
OPENCLAW_GATEWAY_TOKEN=
