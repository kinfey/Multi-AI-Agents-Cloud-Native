{
  "name": "teamsbot-app",
  "version": "1.0.0",
  "description": "Microsoft Teams bot that drives the OpenClaw multi-agent workflow through the acamcp_node MCP service.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "botbuilder": "^4.23.1",
    "dotenv": "^16.4.5",
    "restify": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/restify": "^8.5.12",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
