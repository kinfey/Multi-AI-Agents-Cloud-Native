FROM node:22-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg lsb-release unzip zip \
    && mkdir -p /etc/apt/keyrings \
    && curl -sLS https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg \
    && chmod go+r /etc/apt/keyrings/microsoft.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ bookworm main" > /etc/apt/sources.list.d/azure-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends azure-cli \
    && curl -fsSL https://aka.ms/aca-cli-install | sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate

WORKDIR /app
COPY . .
COPY docker/entrypoint.sh /usr/local/bin/openclaw-entrypoint.sh
COPY custom/scripts/save-agent-pack /usr/local/bin/save-agent-pack
COPY custom/scripts/deploy-agent-to-aca /usr/local/bin/deploy-agent-to-aca
COPY custom/agents /opt/openclaw-agents
RUN chmod +x /usr/local/bin/openclaw-entrypoint.sh /usr/local/bin/save-agent-pack /usr/local/bin/deploy-agent-to-aca \
    && pnpm config set fetch-timeout 600000 \
    && pnpm config set fetch-retries 5 \
    && pnpm config set fetch-retry-mintimeout 10000 \
    && pnpm config set fetch-retry-maxtimeout 120000 \
    && pnpm install --no-frozen-lockfile
RUN pnpm exec vitest run extensions/save-agent/index.test.ts \
    && OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 pnpm_config_verify_deps_before_run=false pnpm build:docker \
    && OPENCLAW_PREFER_PNPM=1 pnpm_config_verify_deps_before_run=false pnpm ui:build
# NOTE: `pnpm prune --prod` was removed here. On the ACR build agent's overlay
# storage, pruning devDependencies (deleting thousands of small files) stalled
# for >1.5h and timed out the build. Skipping it keeps the image larger but
# makes builds complete reliably; interrupting a prune could also corrupt
# node_modules. The cheap cache cleanups below still run.
RUN node -e 'const fs=require("node:fs");const path="package.json";const pkg=JSON.parse(fs.readFileSync(path,"utf8"));pkg.packageManager="pnpm@11.11.0";fs.writeFileSync(path,JSON.stringify(pkg,null,2)+"\n")' \
    && rm -rf test tests coverage .cache .turbo .work

ENV OPENCLAW_CONFIG_PATH=/state/openclaw/openclaw.json5
EXPOSE 18789
ENTRYPOINT ["/usr/local/bin/openclaw-entrypoint.sh"]
