# =============================================================================
# acasbxapp_node — OpenClaw gateway (agents + Foundry + ACA Sandbox) config
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# The deploy/build scripts automatically load this .env from the project root.
# =============================================================================

# ---- Azure target ----------------------------------------------------------
# AZURE_SUBSCRIPTION_ID: the subscription that owns the resources below
#   (GUID). Get it with `az account show --query id -o tsv`.
AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP: resource group for the gateway, ACR, storage, sandbox.
AZURE_RESOURCE_GROUP=rg-openclaw
# AZURE_LOCATION: Azure region for all resources (e.g. swedencentral, westus).
AZURE_LOCATION=swedencentral
# AZURE_OPENCLAW_PREFIX: naming prefix for the ACA app + related resources.
AZURE_OPENCLAW_PREFIX=azure-openclaw-aca

# ---- Microsoft Foundry / Azure AI Foundry ----------------------------------
# AZURE_AI_FOUNDRY_ENDPOINT: the Foundry models endpoint the gateway calls.
#   Format: https://<foundry-resource>.services.ai.azure.com/models
AZURE_AI_FOUNDRY_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/models
# AZURE_AI_FOUNDRY_MODEL_DEPLOYMENT: the model deployment name (e.g. gpt-5.5).
AZURE_AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-5.5

# ---- OpenClaw gateway ------------------------------------------------------
# OPENCLAW_GATEWAY_TOKEN: bearer token protecting the gateway /v1 API and used
#   to download artifact ZIPs (SECRET — do not commit). Generate with
#   `openssl rand -hex 24`. The MCP service + Teams bot must use the same value.
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_URL: public HTTPS URL of the deployed gateway (ACA FQDN).
#   Set after the first deploy; used for Control UI origins + artifact links.
OPENCLAW_GATEWAY_URL=
# OPENCLAW_CONFIG_PATH: in-container path to openclaw.json5 on the persistent
#   volume (default: /state/openclaw/openclaw.json5).
OPENCLAW_CONFIG_PATH=/state/openclaw/openclaw.json5

# ---- Container image / registry / storage ----------------------------------
# ACR_NAME: Azure Container Registry name (without the .azurecr.io suffix).
ACR_NAME=
# STORAGE_ACCOUNT_NAME: storage account backing the Azure Files /state share.
STORAGE_ACCOUNT_NAME=
# OPENCLAW_IMAGE: full gateway image reference pushed to ACR, e.g.
#   <acr-name>.azurecr.io/openclaw:latest
OPENCLAW_IMAGE=
# DOCKER_PLATFORM: build/target platform — ACA expects linux/amd64.
DOCKER_PLATFORM=linux/amd64
# OPENCLAW_UPDATE_SOURCE: 1 to re-pull/update the OpenClaw source during the
#   image build, 0 to reuse the vendored copy (default: 0).
OPENCLAW_UPDATE_SOURCE=0

# ---- ACA Sandbox (isolated tool execution) ---------------------------------
# OPENCLAW_ACA_SANDBOX_ID: the reused ACA Sandbox instance ID the agents share.
OPENCLAW_ACA_SANDBOX_ID=
# OPENCLAW_ACA_SANDBOX_GROUP: the ACA Sandbox group/pool name.
OPENCLAW_ACA_SANDBOX_GROUP=azure-openclaw-aca-sandbox
# OPENCLAW_ACA_DEPLOY_MI_ACR: ACR name (only) that the sandbox deploy managed
#   identity is granted AcrPush on; used by scripts/setup-aca-sandbox.sh.
OPENCLAW_ACA_DEPLOY_MI_ACR=
# ACA_SANDBOX_DISK_ID: committed sandbox disk image ID (az CLI + containerapp
#   extension + deploy helpers baked in). Create via
#   `aca sandbox commit --id <id> --name openclaw-deploy-v1`.
ACA_SANDBOX_DISK_ID=
