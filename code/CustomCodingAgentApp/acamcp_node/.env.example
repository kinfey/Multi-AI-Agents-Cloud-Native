# =============================================================================
# acamcp_node — MCP service (workflow orchestrator) deploy configuration
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# =============================================================================

# ---- Azure / AKS target ----------------------------------------------------
# AZURE_RESOURCE_GROUP: resource group holding the AKS cluster + ACR.
AZURE_RESOURCE_GROUP=rg-openclaw
# AZURE_LOCATION: Azure region of the cluster (e.g. swedencentral, westus).
AZURE_LOCATION=swedencentral
# AKS_CLUSTER_NAME: name of the AKS cluster the MCP service is deployed to.
AKS_CLUSTER_NAME=aks-openclaw

# ---- Azure Container Registry ----------------------------------------------
# ACR_NAME: Azure Container Registry name (without the .azurecr.io suffix).
ACR_NAME=
# ACR_LOGIN_SERVER: full registry login server (e.g. <acr-name>.azurecr.io).
#   If blank, scripts derive it from ACR_NAME.
ACR_LOGIN_SERVER=

# ---- MCP server image ------------------------------------------------------
# MCP_IMAGE: full MCP image reference (built by scripts/build-images.sh), e.g.
#   <acr-login-server>/acamcp-server:latest. If blank, derived from ACR + tag.
MCP_IMAGE=
# IMAGE_TAG: image tag to build/deploy (default: latest).
IMAGE_TAG=latest
# DOCKER_PLATFORM: build/target platform — AKS nodes expect linux/amd64.
DOCKER_PLATFORM=linux/amd64

# ---- Kubernetes ------------------------------------------------------------
# K8S_NAMESPACE: namespace the MCP service + gateway run in (default: openclaw).
K8S_NAMESPACE=openclaw

# ---- OpenClaw gateway (acasbxapp_node) the MCP service calls ----------------
# OPENCLAW_GATEWAY_URL: base URL of the OpenClaw gateway (its ACA FQDN or the
#   in-cluster service URL). The orchestrator calls its /v1 API.
OPENCLAW_GATEWAY_URL=
# OPENCLAW_GATEWAY_TOKEN: gateway bearer token (SECRET — do not commit). If left
#   blank, deploy-aks.sh reads it from ../acasbxapp_node/.env
#   (OPENCLAW_GATEWAY_TOKEN). Must match the gateway's token.
OPENCLAW_GATEWAY_TOKEN=

# ---- Public MCP ingress (AKS app-routing NGINX) ----------------------------
# MCP_HOST: public host for the MCP ingress, e.g. <public-ip>.nip.io. Leave
#   blank to skip the host match and use kubectl port-forward instead.
MCP_HOST=
# CERT_ISSUER: cert-manager ClusterIssuer for TLS on the ingress
#   (default: letsencrypt-prod).
CERT_ISSUER=letsencrypt-prod
# MCP_BASIC_AUTH_USER: HTTP Basic auth username for the MCP ingress.
MCP_BASIC_AUTH_USER=mcp
# MCP_BASIC_AUTH_PASSWORD: HTTP Basic auth password (SECRET — do not commit).
#   When set, deploy-aks.sh (re)creates the acamcp-basic-auth secret. Leave
#   blank to keep the existing secret unchanged.
MCP_BASIC_AUTH_PASSWORD=
