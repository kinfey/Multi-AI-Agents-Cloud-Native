              {
                "name": "AZURE_CLIENT_ID",
                "value": "[reference(resourceId('Microsoft.Resources/deployments', 'identity'), '2025-04-01').outputs.identityClientId.value]"
              }
            ]
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "1382407717546297212"
            }
          },
          "parameters": {
            "namePrefix": {
              "type": "string",
              "metadata": {
                "description": "Resource name prefix."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region."
              }
            },
            "resourceToken": {
              "type": "string",
              "metadata": {
                "description": "Short, deterministic token derived from RG id."
              }
            },
            "managedIdentityId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the user-assigned managed identity."
              }
            },
            "managedIdentityClientId": {
              "type": "string",
              "metadata": {
                "description": "Client ID of the managed identity (passed in as AZURE_CLIENT_ID)."
              }
            },
            "webappImage": {
              "type": "string",
              "metadata": {
                "description": "Container image reference for the webapp."
              }
            },
            "containerRegistryServer": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional container registry server (e.g. myacr.azurecr.io). Blank for public images."
              }
            },
            "envVars": {
              "type": "array",
              "metadata": {
                "description": "Environment variables passed to the webapp container."
              }
            }
          },
          "variables": {
            "workspaceName": "[format('{0}-log-{1}', parameters('namePrefix'), parameters('resourceToken'))]",
            "environmentName": "[format('{0}-cae-{1}', parameters('namePrefix'), parameters('resourceToken'))]",
            "webappName": "[format('{0}-web-{1}', parameters('namePrefix'), parameters('resourceToken'))]",
            "registryConfig": "[if(empty(parameters('containerRegistryServer')), createArray(), createArray(createObject('server', parameters('containerRegistryServer'), 'identity', parameters('managedIdentityId'))))]"
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[variables('workspaceName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2024-03-01",
              "name": "[variables('environmentName')]",
              "location": "[parameters('location')]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').primarySharedKey]"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[variables('webappName')]",
              "location": "[parameters('location')]",
              "tags": {
                "azd-service-name": "webapp"
              },
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('managedIdentityId'))]": {}
                }
              },
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
                "configuration": {
                  "ingress": {
                    "external": true,
                    "targetPort": 8000,
                    "transport": "auto",
                    "allowInsecure": false
                  },
                  "registries": "[variables('registryConfig')]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "webapp",
                      "image": "[parameters('webappImage')]",
                      "resources": {
                        "cpu": "[json('1.0')]",
                        "memory": "2.0Gi"
                      },
                      "env": "[union(parameters('envVars'), createArray(createObject('name', 'AZURE_CLIENT_ID', 'value', parameters('managedIdentityClientId'))))]"
                    }
                  ],
                  "scale": {
                    "minReplicas": 1,
                    "maxReplicas": 3
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]"
              ]
            }
          ],
          "outputs": {
            "webappUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('webappName')), '2024-03-01').configuration.ingress.fqdn)]"
            },
            "webappName": {
              "type": "string",
              "value": "[variables('webappName')]"
            },
            "environmentName": {
              "type": "string",
              "value": "[variables('environmentName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'identity')]",
        "[resourceId('Microsoft.Resources/deployments', 'storage')]"
