          },
          "resourceToken": {
            "value": "[variables('resourceToken')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "151997567496717631"
            }
          },
          "parameters": {
            "namePrefix": {
              "type": "string",
              "metadata": {
                "description": "Resource name prefix."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region."
              }
            },
            "resourceToken": {
              "type": "string",
              "metadata": {
                "description": "Short, deterministic token derived from RG id."
              }
            }
          },
          "variables": {
