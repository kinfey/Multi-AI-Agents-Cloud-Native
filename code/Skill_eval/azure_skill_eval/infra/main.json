  "outputs": {
    "webappUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'containerapps'), '2025-04-01').outputs.webappUrl.value]"
    },
    "storageAccountUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage'), '2025-04-01').outputs.storageAccountUrl.value]"
    },
    "storageContainer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage'), '2025-04-01').outputs.containerName.value]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'identity'), '2025-04-01').outputs.identityClientId.value]"
    },
    "containerRegistryServer": {
      "type": "string",
      "value": "[parameters('containerRegistryServer')]"
    }
  }
}