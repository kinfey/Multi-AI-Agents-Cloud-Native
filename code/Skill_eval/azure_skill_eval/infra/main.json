                "value": "[parameters('FOUNDRY_PROJECT_ENDPOINT')]"
              },
              {
                "name": "MODEL_GPT",
                "value": "[parameters('MODEL_GPT')]"
              },
              {
                "name": "MODEL_DEEPSEEK",
                "value": "[parameters('MODEL_DEEPSEEK')]"
              },
