# --- Azure Foundry (required) ---
# Example: https://my-account.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_ENDPOINT=

# Foundry model deployment names (override only if your deployments differ).
MODEL_GPT=gpt-5.5
MODEL_DEEPSEEK=DeepSeek-V4-Pro

# --- Azure Blob Storage (required) ---
# Example: https://mystorageacct.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=skill-eval-runs

# --- Foundry Hosted Agent SUT mode (required for business agent evaluation) ---
REQUIRE_FOUNDRY_AGENT=1
FOUNDRY_AGENT_NAME_GPT=skill-eval-business-agent-gpt
FOUNDRY_AGENT_NAME_DEEPSEEK=skill-eval-business-agent-deepseek
FOUNDRY_AGENT_NAME_ATTACKER=skill-eval-attacker-agent
FOUNDRY_AGENT_NAME_JUDGE=skill-eval-judge-agent

# Optional: pin specific hosted-agent versions. azd writes AGENT_*_VERSION
# automatically after `azd deploy`; leave empty locally to use @latest.
FOUNDRY_AGENT_VERSION_GPT=
FOUNDRY_AGENT_VERSION_DEEPSEEK=
FOUNDRY_AGENT_VERSION_ATTACKER=
FOUNDRY_AGENT_VERSION_JUDGE=

# --- Eval defaults ---
EVAL_REQUEST_TIMEOUT=120
EVAL_JUDGE_TIMEOUT=120
EVAL_MAX_TURNS=3
EVAL_USE_ATTACK=1
EVAL_USE_JUDGE=1

# Backward-compatible aliases also accepted by shared.config:
# MAX_TURNS=3
# USE_ATTACK=1
# USE_JUDGE=1
