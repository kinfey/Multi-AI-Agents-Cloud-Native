# Leave empty for local dev: empty => DefaultAzureCredential (az login).
# Set only in AKS/ACA, where scripts/configure-aks.sh injects the workload identity client id.
AZURE_CLIENT_ID=
# Required for Azure deployment: fill in values from your Azure environment.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AKS_CLUSTER_NAME=
AZURE_AKS_ADMIN_PRINCIPAL_ID=
# Blob endpoint of the media storage account, e.g. https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=media
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_ACCOUNT_NAME=
AZURE_TEXT_MODEL=gpt-5.5
# Local Compose runs the KARS inference router without the AKS controller, so
# it needs the model endpoint and credential explicitly.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_MODEL=MAI-Image-2.5-Pro
AZURE_IMAGE_API_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_VOICE=zh-CN-Mei
TTS_BACKEND=mai-voice
AZURE_VOICE_MODEL=MAI-Voice-2
AZURE_VOICE_NAME_CN=zh-CN-Mei
AZURE_VOICE_NAME_EN=en-US-Olivia
# Comma-separated RSS sources. Every host listed here must also appear in the
# allowedEndpoints of media-claw-agent in kars/base/sandboxes.yaml, otherwise
# Strict egress will block the fetch.
NEWS_FEED_URLS=https://www.cnbc.com/id/20910258/device/rss/rss.html,https://www.cnbc.com/id/10000664/device/rss/rss.html,https://finance.yahoo.com/news/rssindex
CORS_ORIGINS=http://localhost:8080
KARS_OPENCLAW_IMAGE=ghcr.io/azure/openclaw-sandbox:v0.1.25
# Local dev tag (matches Makefile default). scripts/configure-aks.sh overwrites this
# with <acr-login-server>/media-claw-agent:<tag> after azd provision creates the ACR.
MEDIA_CLAW_OPENCLAW_IMAGE=local.azurecr.io/media-claw-agent:dev
