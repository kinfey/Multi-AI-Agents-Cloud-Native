# --- Microsoft Foundry (Azure AI Foundry) ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project-name>
FOUNDRY_MODEL=gpt-5.5

# --- Hyperlight Wasm sandbox ---
# Absolute path to the prebuilt python-sandbox.aot guest module.
# Build it via the hyperlight-sandbox repo: `just guest-build`
# Default location: <hyperlight-sandbox>/src/wasm_sandbox/guests/python/python-sandbox.aot
HYPERLIGHT_PYTHON_MODULE_PATH=C:\path\to\hyperlight-sandbox\src\wasm_sandbox\guests\python\python-sandbox.aot

# --- Workflow output ---
# Host directory mapped to /output inside the sandbox.
# All scripts are written under <PODCAST_OUTPUT_DIR>/<YYMMDD>/.
PODCAST_OUTPUT_DIR=./outputs
